{
  // Test-suite typecheck: the exact same compiler contract as the build
  // (strict, unused checks on) but over `tests/` too, so a spec fixture can no
  // longer drift from the interfaces it fakes without failing a gate. The
  // build config keeps `rootDir: src` for declaration output; this project
  // never emits, so it widens the root instead. CLI declarations, scripts,
  // and root configs are included for ESLint's type-aware pass.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts", "bin/**/*.d.mts", "*.config.ts"]
}
